{
  "name": "automation-exercise-playwright-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript UI, API and hybrid automation framework for Automation Exercise",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:hybrid": "playwright test --project=hybrid-chromium",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.3",
    "dotenv": "^17.2.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
